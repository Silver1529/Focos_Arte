# TigerHub — variáveis de ambiente
# Copie para .env.local e ajuste conforme necessário.
# Na v1 (sem banco) nenhuma variável é obrigatória — os valores abaixo são opcionais.

# Número de WhatsApp usado nos CTAs (somente dígitos, com DDI + DDD).
# Se ausente, usa o padrão definido em src/lib/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=5538999990000

